---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import logo from '../../assets/wlczak_logo.png';
import Layout from '../layouts/Layout.astro';
import Desktop from './Desktop.astro';
import ProjectCard from './ProjectCard';
import ProjectArt from './ProjectArt';
import ProjectDirectory from './ProjectDirectory';
import { allProjects, projectCards } from '../lib/projects';
import { messages, url, type Locale } from '../lib/i18n';
interface Props { locale: Locale; page: string }
const { locale, page } = Astro.props;
const t = messages[locale];
const cards = await projectCards(locale);
const profile = (await getEntry('profiles',locale))!.data;
const projectId = page.startsWith('projects/') ? page.split('/')[1] : undefined;
const project = projectId ? (await allProjects()).find(p=>p.id===projectId) : undefined;
const is404 = page==='404';
const title = project ? `${project.data.name} — Adam Vlček` : page==='about' ? `${t.aboutTitle} — Adam Vlček` : page==='projects' ? `${t.projectsTitle} — Adam Vlček` : is404 ? `404 — Adam Vlček` : t.identity;
const description = project ? project.data.description[locale] : page==='about' ? t.aboutDescription : page==='projects' ? t.projectsIntro : t.homeDescription;
const breadcrumbs = page.startsWith('projects') ? [{name:t.home,path:''},{name:t.projects,path:'projects'},...(project?[{name:project.data.name,path:page}]:[])] : [];
---
<Layout locale={locale} page={page} title={title} description={description} noindex={is404} breadcrumbs={breadcrumbs}>
  {page==='' && <>
    <section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> ADAM VLČEK / {t.role}</p><h1>{t.heroLead}<br /><span>{t.heroEnd}</span></h1><p class="hero-description">{t.heroText}</p><div class="hero-actions"><a class="button primary" href={url(locale,'projects')}>{t.explore} <span aria-hidden="true">↗</span></a><a class="text-link" href={url(locale,'about')}>{t.meet} <span aria-hidden="true">→</span></a></div><p class="location mono"><span aria-hidden="true">⌖</span> {t.location} <span aria-hidden="true">·</span> PHP / GO / JAVA</p></div><Desktop locale={locale} /></section>
    <section class="featured section"><div class="section-heading"><div><p class="eyebrow">01 / {t.projects}</p><h2>{t.featured}</h2><p>{t.featuredIntro}</p></div><a class="text-link" href={url(locale,'projects')}>{t.allProjects} ↗</a></div><div class="project-grid">{cards.filter(p=>p.featured).map(project=><ProjectCard project={project} locale={locale} />)}</div></section>
    <section class="section interests"><p class="eyebrow">02 / {t.aboutLabel}</p><h2>{t.interests}</h2><div class="interest-grid">{(['web','games','hardware'] as const).map((key,i)=><article class="interest-card"><span class="interest-icon mono" aria-hidden="true">{['</>','+','▤'][i]}</span><h3>{t[key]}</h3><p>{t[`${key}Text`]}</p></article>)}</div></section>
    <section class="contact-panel"><div><p class="eyebrow">03 / GITHUB</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div><a class="button primary" href="https://github.com/Wlczak" target="_blank" rel="noopener noreferrer">{t.github} ↗</a></section>
  </>}
  {page==='about' && <>
    <header class="page-heading"><p class="eyebrow">~/adam/about.txt</p><h1>{t.aboutTitle}</h1><p>{profile.intro}</p></header>
    <div class="about-grid"><section class="window about-window"><div class="window-bar"><span class="window-dots" aria-hidden="true">● ● ●</span><span>about.txt</span></div><div class="window-content prose"><h2>{t.aboutLabel}</h2><p>{profile.bio}</p><h2>{t.learning}</h2><p>{profile.learning}</p><h2>{t.approach}</h2><p>{t.approachText}</p><a class="text-link" href={url(locale,'projects')}>{t.explore} ↗</a></div></section><aside class="identity-panel"><Picture src={logo} formats={['avif','webp']} widths={[160,320]} sizes="160px" width={160} height={160} alt="" /><h2>Adam Vlček</h2><p>{t.role}</p><p class="mono">{t.location}</p><hr /><h3>{t.toolkit}</h3><ul class="tags"><li>PHP</li><li>Go</li><li>Java</li><li>SQL</li><li>WebSockets</li><li>Arduino</li></ul><a class="button" href="https://github.com/Wlczak" target="_blank" rel="noopener noreferrer">GitHub ↗</a></aside></div>
  </>}
  {page==='projects' && <>
    <header class="page-heading"><p class="eyebrow">~/adam/projects/</p><h1>{t.projectsTitle}</h1><p>{t.projectsIntro}</p></header>
    <section class="directory" aria-labelledby="directory-heading"><h2 id="directory-heading" class="sr-only">{t.projects}</h2><ProjectDirectory projects={cards} locale={locale} client:load /></section>
  </>}
  {project && <>
    <nav class="breadcrumbs" aria-label="Breadcrumb">{breadcrumbs.map((crumb,i)=><><a href={url(locale,crumb.path)} aria-current={i===breadcrumbs.length-1?'page':undefined}>{crumb.name}</a>{i<breadcrumbs.length-1 && <span aria-hidden="true">/</span>}</>)}</nav>
    <header class="page-heading project-heading"><p class="eyebrow">{t[project.data.category]} / {project.id.toUpperCase()}</p><h1>{project.data.name}</h1><p>{project.data.description[locale]}</p></header>
    <div class="project-detail-grid"><figure class="detail-art"><ProjectArt id={project.id} /><figcaption>{t.illustration}</figcaption></figure><aside class="window project-links"><div class="window-bar"><span>{t.technologies}</span><span aria-hidden="true">▣</span></div><div class="window-content"><ul class="tags">{project.data.technologies.map(tech=><li>{tech}</li>)}</ul><div class="project-actions">{project.data.demo && <a class="button primary" href={project.data.demo} target="_blank" rel="noopener noreferrer">{t[project.data.action]} ↗</a>}{project.data.source && !project.data.unavailable && <a class="button" href={project.data.source} target="_blank" rel="noopener noreferrer">{t.source} ↗</a>}{project.data.unavailable && <p class="release-note">{t.unavailable}</p>}</div></div></aside></div>
    <div class="project-story prose"><section><p class="eyebrow">01</p><h2>{t.purpose}</h2><p>{project.data.purpose[locale]}</p></section><section><p class="eyebrow">02</p><h2>{t.implementation}</h2><p>{project.data.approach[locale]}</p></section></div>
    <section class="section"><div class="section-heading"><h2>{t.more}</h2><a class="text-link" href={url(locale,'projects')}>{t.back} →</a></div><div class="project-grid">{cards.filter(p=>p.id!==project.id).slice(0,3).map(project=><ProjectCard project={project} locale={locale} />)}</div></section>
  </>}
  {is404 && <section class="not-found"><p class="error-code mono" aria-hidden="true">404<span>_</span></p><p class="eyebrow">FILE_NOT_FOUND</p><h1>{t.notFound}</h1><p>{t.notFoundText}</p><a class="button primary" href={url(locale)}>{t.returnHome} →</a></section>}
</Layout>

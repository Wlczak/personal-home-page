---
import { messages, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = messages[locale];
---
<div class="desktop-art">
  <span class="spark spark-one" aria-hidden="true">✳</span><span class="spark spark-two" aria-hidden="true">+</span>
  <div class="art-sticker mono" aria-hidden="true">HELLO, WORLD!</div>
  <div class="computer" data-computer data-locale={locale}>
    <button type="button" class="computer-activate" aria-label={t.computerActivate} aria-controls="computer-input" hidden></button>
    <div class="monitor"><div class="screen">
      <div class="screen-menu"><span aria-hidden="true">adam@localhost</span><span class="screen-idle-icon" aria-hidden="true">▣</span><button type="button" class="computer-close" aria-label={t.close} hidden><span aria-hidden="true">ESC ×</span></button></div>
      <div class="terminal">
        <div class="terminal-history" aria-hidden="true"><span class="terminal-comment">// a work in progress</span><br /><span class="terminal-prompt">$</span> whoami<br /><strong>Adam Vlček</strong><br /><span class="terminal-prompt">$</span> cat interests.txt<br /><span>backend / games / hardware</span></div>
        <div class="terminal-idle-prompt" aria-hidden="true"><span class="terminal-prompt">$</span> <span class="cursor">▌</span></div>
        <div class="terminal-transcript" role="log" aria-label={t.computerTerminal} aria-live="polite" hidden></div>
        <div class="terminal-entry" hidden><span class="terminal-prompt" aria-hidden="true">$</span><div class="terminal-input-wrap"><div class="terminal-ghost" aria-hidden="true"><span class="terminal-ghost-prefix"></span><span class="terminal-suggestion"></span></div><textarea id="computer-input" class="terminal-editor" aria-label={t.terminalInput} rows="1" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea></div></div>
        <ul class="terminal-completions" aria-label="Completion options" hidden></ul>
        <div class="terminal-completion-pages" hidden>
          <button type="button" class="completion-previous" aria-label="Previous completion page">← Previous</button>
          <span class="completion-page-status" role="status"></span>
          <button type="button" class="completion-next" aria-label="Next completion page">Next →</button>
        </div>
        <section class="nano-editor" aria-label="Nano text editor" hidden>
          <div class="nano-header"><span>nano</span><span class="nano-filename"></span><span class="nano-modified"></span></div>
          <textarea class="nano-input" aria-label="File contents" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
          <div class="nano-status" role="status">Ctrl+O to save · Ctrl+X to exit</div>
          <div class="nano-confirm" hidden><span>Save changes before exiting?</span><button type="button" data-nano="save-exit">Yes · Save</button><button type="button" data-nano="discard">No · Discard</button><button type="button" data-nano="cancel">Cancel</button></div>
          <div class="nano-shortcuts"><button type="button" data-nano="help">^G Help</button><button type="button" data-nano="save">^O Save</button><button type="button" data-nano="exit">^X Exit</button></div>
        </section>
      </div>
      <div class="screen-status" aria-hidden="true"><span>Go + Astro</span><span>● {t.location}</span></div>
    </div><div class="monitor-footer" aria-hidden="true"><span>AV / 01</span><span class="power-light"></span></div></div>
    <div class="monitor-neck" aria-hidden="true"></div><div class="monitor-base" aria-hidden="true"></div>
    <div class="keyboard" aria-hidden="true"><div></div><div></div><div></div><div class="spacebar"></div></div>
  </div>
  <div class="floppy" aria-hidden="true"><span>IDEAS<br />&amp; OTHER<br />GOOD STUFF</span><div></div></div>
  <dialog class="computer-dialog" aria-label={t.computerTerminal}></dialog>
</div>

<script>
  import { createTerminal, type Completion } from '../lib/terminal';
  import type { Locale } from '../lib/i18n';

  document.querySelectorAll<HTMLElement>('[data-computer]').forEach(computer => {
    const shell = createTerminal(computer.dataset.locale as Locale);
    const activate = computer.querySelector<HTMLButtonElement>('.computer-activate');
    const idlePrompt = computer.querySelector<HTMLElement>('.terminal-idle-prompt');
    const entry = computer.querySelector<HTMLElement>('.terminal-entry');
    const editor = computer.querySelector<HTMLTextAreaElement>('.terminal-editor');
    const transcript = computer.querySelector<HTMLElement>('.terminal-transcript');
    const ghost = computer.querySelector<HTMLElement>('.terminal-ghost')!;
    const ghostPrefix = computer.querySelector<HTMLElement>('.terminal-ghost-prefix')!;
    const suggestion = computer.querySelector<HTMLElement>('.terminal-suggestion')!;
    const completions = computer.querySelector<HTMLUListElement>('.terminal-completions')!;
    const pagination = computer.querySelector<HTMLElement>('.terminal-completion-pages')!;
    const previousPage = computer.querySelector<HTMLButtonElement>('.completion-previous')!;
    const nextPage = computer.querySelector<HTMLButtonElement>('.completion-next')!;
    const pageStatus = computer.querySelector<HTMLElement>('.completion-page-status')!;
    const terminal = computer.querySelector<HTMLElement>('.terminal')!;
    const nano = computer.querySelector<HTMLElement>('.nano-editor')!;
    const nanoInput = computer.querySelector<HTMLTextAreaElement>('.nano-input')!;
    const nanoFilename = computer.querySelector<HTMLElement>('.nano-filename')!;
    const nanoModified = computer.querySelector<HTMLElement>('.nano-modified')!;
    const nanoStatus = computer.querySelector<HTMLElement>('.nano-status')!;
    const nanoConfirm = computer.querySelector<HTMLElement>('.nano-confirm')!;
    let editing: { path: string; content: string } | null = null;
    const pageSize = 6;
    let completionPage = 0;
    let visibleOptions: Completion[] = [];
    let completionCycle: { options: Completion[]; index: number } | null = null;
    let suggestedValue = '';
    const close = computer.querySelector<HTMLButtonElement>('.computer-close');
    const icon = computer.querySelector<HTMLElement>('.screen-idle-icon');
    const parent = computer.parentElement;
    const dialog = parent?.querySelector<HTMLDialogElement>('.computer-dialog');
    const nextSibling = computer.nextSibling;
    if (!activate || !idlePrompt || !entry || !editor || !transcript || !close || !icon || !parent || !dialog) return;
    const history: string[] = [];
    let historyIndex = 0;
    let draft = '';
    let previousOverflow = '';
    let placeholder: HTMLElement | null = null;
    let closing = false;
    let animations: Animation[] = [];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const shapeSelector = '.screen, .screen-menu, .terminal, .screen-status';
    const shapes = Array.from(computer.querySelectorAll<HTMLElement>(shapeSelector));
    const text = computer.querySelector<HTMLElement>('.terminal strong')!;
    const styleProperties = ['width', 'height', 'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft', 'marginTop', 'marginBottom', 'borderRadius', 'fontSize', 'lineHeight'] as const;
    function frame(element: HTMLElement): Keyframe {
      const style = getComputedStyle(element);
      return Object.fromEntries(styleProperties.map(property => [property, style[property]]));
    }
    function compactFrames() {
      return Array.from(placeholder!.querySelectorAll<HTMLElement>(shapeSelector)).map(frame);
    }
    function stopAnimations() {
      animations.forEach(animation => animation.cancel());
      animations = [];
    }
    function compactTransform() {
      const screen = placeholder!.querySelector<HTMLElement>('.screen')!;
      const source = screen.getBoundingClientRect();
      const target = computer.getBoundingClientRect();
      const x = source.x + source.width / 2 - target.x - screen.offsetWidth / 2;
      const y = source.y + source.height / 2 - target.y - screen.offsetHeight / 2;
      return `translate(${x}px, ${y}px) rotate(-3deg)`;
    }
    function compactComputerFrame(): Keyframe {
      const screen = placeholder!.querySelector<HTMLElement>('.screen')!;
      return {width: `${screen.offsetWidth}px`, height: `${screen.offsetHeight}px`, transform: compactTransform()};
    }
    async function transition(from: Keyframe, to: Keyframe, fromShapes: Keyframe[], toShapes: Keyframe[], fromText: Keyframe, toText: Keyframe, opening: boolean, background: string) {
      stopAnimations();
      if (reducedMotion.matches) return;
      const options = {duration: opening ? 520 : 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' as const};
      const motion = computer.animate([from, to], options);
      const fade = dialog!.animate([{backgroundColor: background}, {backgroundColor: opening ? '#172620' : 'transparent'}], options);
      // Expand only the CLI. The original hardware stays untouched behind it.
      const shapeAnimations = shapes.map((shape, index) => shape.animate([
        {...fromShapes[index], flex: '0 0 auto'},
        {...toShapes[index], flex: '0 0 auto'},
      ], options));
      const textAnimation = text.animate([fromText, toText], options);
      animations = [motion, fade, ...shapeAnimations, textAnimation];
      await Promise.all(animations.map(animation => animation.finished.catch(() => {})));
      // A newer transition may have interrupted this one.
      if (animations[0] === motion) stopAnimations();
    }
    function resizeInput() {
      editor!.style.height = 'auto';
      editor!.style.height = `${Math.max(editor!.scrollHeight, ghost.scrollHeight)}px`;
    }
    function atEnd() {
      return editor!.selectionStart === editor!.value.length && editor!.selectionEnd === editor!.value.length;
    }
    function refreshSuggestions(reset = true) {
      if (reset) {
        completionCycle = null;
        completionPage = 0;
      }
      suggestedValue = atEnd() ? shell.suggest(editor!.value) : '';
      ghostPrefix.textContent = suggestedValue ? editor!.value : '';
      suggestion.textContent = suggestedValue.slice(editor!.value.length);
      const options = atEnd() ? completionCycle?.options ?? (editor!.value ? shell.complete(editor!.value) : []) : [];
      visibleOptions = options;
      const pageCount = Math.ceil(options.length / pageSize);
      completionPage = Math.min(completionPage, Math.max(0, pageCount - 1));
      pagination.hidden = pageCount <= 1;
      previousPage.disabled = completionPage === 0;
      nextPage.disabled = completionPage >= pageCount - 1;
      pageStatus.textContent = pageCount > 1 ? `${completionPage + 1} / ${pageCount} · ${options.length} options` : '';
      completions.replaceChildren();
      completions.hidden = options.length === 0;
      const start = completionPage * pageSize;
      options.slice(start, start + pageSize).forEach((option, offset) => {
        const index = start + offset;
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = option.label;
        button.dataset.completionIndex = String(index);
        button.setAttribute('aria-pressed', String(completionCycle?.index === index));
        button.addEventListener('click', () => {
          editor!.value = option.value;
          editor!.focus();
          editor!.setSelectionRange(option.value.length, option.value.length);
          refreshSuggestions();
          updateInput();
        });
        item.append(button);
        completions.append(item);
      });
      resizeInput();
    }
    function updateInput() {
      resizeInput();
      const terminal = computer.querySelector<HTMLElement>('.terminal');
      if (terminal) terminal.scrollTop = terminal.scrollHeight;
    }
    function appendCommand(valueText: string) {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      const prompt = document.createElement('span');
      prompt.className = 'terminal-prompt';
      prompt.setAttribute('aria-hidden', 'true');
      prompt.textContent = '$';
      const value = document.createElement('span');
      // Render commands and output as text, never HTML.
      value.textContent = valueText;
      line.append(prompt, value);
      transcript!.append(line);
    }
    function resetInput() {
      editor!.value = '';
      historyIndex = history.length;
      draft = '';
      refreshSuggestions();
      updateInput();
    }
    function selectCompletion(options: Completion[], index: number) {
      completionCycle = { options, index };
      completionPage = Math.floor(index / pageSize);
      editor!.value = options[index].value;
      editor!.focus({ preventScroll: true });
      editor!.setSelectionRange(editor!.value.length, editor!.value.length);
      historyIndex = history.length;
      refreshSuggestions(false);
      updateInput();
    }
    function changeCompletionPage(direction: number) {
      const pageCount = Math.ceil(visibleOptions.length / pageSize);
      const page = Math.max(0, Math.min(pageCount - 1, completionPage + direction));
      if (page === completionPage || !visibleOptions.length) return;
      selectCompletion(visibleOptions, page * pageSize);
    }
    previousPage.addEventListener('click', () => changeCompletionPage(-1));
    nextPage.addEventListener('click', () => changeCompletionPage(1));
    function openNano(file: { path: string; content: string }) {
      editing = file;
      nanoInput.value = file.content;
      nanoFilename.textContent = file.path;
      nanoModified.textContent = '';
      nanoStatus.textContent = 'Ctrl+O to save · Ctrl+X to exit · Saves last until page reload';
      nanoConfirm.hidden = true;
      nano.hidden = false;
      terminal.dataset.editing = 'true';
      terminal.scrollTop = 0;
      nanoInput.focus({ preventScroll: true });
      nanoInput.setSelectionRange(0, 0);
    }
    function closeNano() {
      editing = null;
      nano.hidden = true;
      nanoConfirm.hidden = true;
      delete terminal.dataset.editing;
      editor!.focus({ preventScroll: true });
      refreshSuggestions();
      updateInput();
    }
    function saveNano() {
      if (!editing) return false;
      try {
        shell.saveFile(editing.path, nanoInput.value);
        editing.content = nanoInput.value;
        nanoModified.textContent = '';
        nanoStatus.textContent = `Saved ${nanoInput.value.split('\n').length} line(s) · Session only`;
        return true;
      } catch (error) {
        nanoStatus.textContent = (error as Error).message;
        return false;
      }
    }
    function requestNanoExit() {
      if (!editing) return;
      if (nanoInput.value === editing.content) closeNano();
      else {
        nanoConfirm.hidden = false;
        nanoConfirm.querySelector<HTMLButtonElement>('button')!.focus();
      }
    }
    function cancelNanoExit() {
      nanoConfirm.hidden = true;
      nanoInput.focus({ preventScroll: true });
    }
    nanoInput.addEventListener('input', () => {
      nanoModified.textContent = nanoInput.value !== editing?.content ? 'Modified' : '';
    });
    nano.addEventListener('click', event => {
      const action = (event.target as Element).closest<HTMLElement>('[data-nano]')?.dataset.nano;
      if (action === 'save') { saveNano(); nanoInput.focus({ preventScroll: true }); }
      else if (action === 'exit') requestNanoExit();
      else if (action === 'save-exit') { if (saveNano()) closeNano(); }
      else if (action === 'discard') closeNano();
      else if (action === 'cancel') cancelNanoExit();
      else if (action === 'help') nanoStatus.textContent = 'Ctrl+O Save · Ctrl+X Exit · Ctrl+G Help · Tab inserts spaces · Files stay in this session';
    });
    nano.addEventListener('keydown', event => {
      if (event.isComposing) return;
      const key = event.key.toLowerCase();
      if (event.ctrlKey && !event.altKey && !event.metaKey && ['o', 'x', 'g', 'c'].includes(key)) {
        event.preventDefault();
        event.stopPropagation();
        if (key === 'o') { saveNano(); nanoInput.focus({ preventScroll: true }); }
        else if (key === 'x') requestNanoExit();
        else if (key === 'c') cancelNanoExit();
        else nanoStatus.textContent = 'Ctrl+O Save · Ctrl+X Exit · Ctrl+G Help · Tab inserts spaces · Files stay in this session';
      } else if (!nanoConfirm.hidden && !event.ctrlKey && !event.altKey && !event.metaKey && ['y', 'n', 'escape'].includes(key)) {
        event.preventDefault();
        event.stopPropagation();
        if (key === 'y') { if (saveNano()) closeNano(); }
        else if (key === 'n') closeNano();
        else cancelNanoExit();
      } else if (event.key === 'Tab' && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey && event.target === nanoInput) {
        event.preventDefault();
        nanoInput.setRangeText('  ', nanoInput.selectionStart, nanoInput.selectionEnd, 'end');
        nanoInput.dispatchEvent(new Event('input'));
      }
    });
    function submitLine() {
      appendCommand(editor!.value);
      const result = shell.execute(editor!.value);
      if (result.clear) {
        transcript!.replaceChildren();
        computer.querySelector<HTMLElement>('.terminal-history')!.hidden = true;
      }
      if (result.output) {
        const output = document.createElement('div');
        output.className = 'terminal-output';
        output.style.whiteSpace = 'pre-wrap';
        output.style.overflowWrap = 'anywhere';
        output.textContent = result.output;
        transcript!.append(output);
      }
      if (editor!.value) history.push(editor!.value);
      resetInput();
      if (result.edit) openNano(result.edit);
    }
    function confirmOrSubmit() {
      if (!completionCycle) {
        submitLine();
        return;
      }
      // Tab/arrow navigation already filled the selected value. Accept it
      // without adding transcript output or executing the command.
      refreshSuggestions();
      completions.hidden = true;
      pagination.hidden = true;
      updateInput();
    }
    // Also cancel while focus is on a completion option. Cancelled input is
    // displayed, but never executed or added to command history.
    dialog.addEventListener('keydown', event => {
      if (editing) return;
      if ((event.key === 'PageUp' || event.key === 'PageDown') && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey && !pagination.hidden) {
        event.preventDefault();
        changeCompletionPage(event.key === 'PageUp' ? -1 : 1);
      }
      if (event.ctrlKey && !event.altKey && !event.metaKey && event.key.toLowerCase() === 'c') {
        event.preventDefault();
        appendCommand(`${editor!.value}^C`);
        resetInput();
        editor!.focus({ preventScroll: true });
      }
    });
    completions.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key) || event.shiftKey || event.ctrlKey || event.altKey || event.metaKey) return;
      const target = event.target as HTMLElement;
      if (!target.matches('button[data-completion-index]')) return;
      const current = Number(target.dataset.completionIndex);
      const options = visibleOptions;
      if (!options.length) return;
      event.preventDefault();
      const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
      selectCompletion(options, (current + direction + options.length) % options.length);
    });
    editor.addEventListener('keydown', event => {
      if (event.isComposing || event.key === 'Process') return;
      if (event.key === 'Tab' && !event.ctrlKey && !event.altKey && !event.metaKey && atEnd()) {
        const options = completionCycle?.options ?? shell.complete(editor.value);
        if (!options.length) return;
        event.preventDefault();
        const index = completionCycle
          ? (completionCycle.index + (event.shiftKey ? -1 : 1) + options.length) % options.length
          : event.shiftKey ? options.length - 1 : 0;
        selectCompletion(options, index);
      } else if (!event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey && atEnd()
        && ((completionCycle && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key))
          || (event.key === 'ArrowDown' && !completions.hidden))) {
        const options = completionCycle?.options ?? shell.complete(editor.value);
        if (!options.length) return;
        event.preventDefault();
        const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
        const index = completionCycle ? (completionCycle.index + direction + options.length) % options.length : 0;
        selectCompletion(options, index);
      } else if (event.key === 'ArrowRight' && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey && atEnd() && suggestedValue) {
        event.preventDefault();
        editor.value = suggestedValue;
        editor.setSelectionRange(editor.value.length, editor.value.length);
        historyIndex = history.length;
        refreshSuggestions();
        updateInput();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        confirmOrSubmit();
      } else if ((event.key === 'ArrowUp' || event.key === 'ArrowDown') && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey) {
        event.preventDefault();
        if (historyIndex === history.length) draft = editor.value;
        historyIndex = Math.max(0, Math.min(history.length, historyIndex + (event.key === 'ArrowUp' ? -1 : 1)));
        editor.value = historyIndex === history.length ? draft : history[historyIndex];
        editor.setSelectionRange(editor.value.length, editor.value.length);
        refreshSuggestions();
        updateInput();
      }
    });
    // Mobile keyboards can submit through beforeinput without a keydown.
    editor.addEventListener('beforeinput', event => {
      if (!event.isComposing && (event.inputType === 'insertLineBreak' || event.inputType === 'insertParagraph')) {
        event.preventDefault();
        confirmOrSubmit();
      }
    });
    editor.addEventListener('input', event => {
      if ((event as InputEvent).isComposing) return;
      // Pasted newlines become spaces rather than silently submitting lines.
      editor.value = editor.value.replace(/[\r\n]+/g, ' ');
      historyIndex = history.length;
      refreshSuggestions();
      updateInput();
    });
    editor.addEventListener('click', () => refreshSuggestions());
    editor.addEventListener('compositionstart', () => {
      completionCycle = null;
      suggestedValue = '';
      ghostPrefix.textContent = '';
      suggestion.textContent = '';
      completions.hidden = true;
      pagination.hidden = true;
    });
    editor.addEventListener('compositionend', () => {
      refreshSuggestions();
      updateInput();
    });
    editor.addEventListener('keyup', event => {
      if (['ArrowLeft', 'Home', 'End', 'ArrowRight'].includes(event.key)) {
        refreshSuggestions(!(completionCycle && atEnd() && ['ArrowLeft', 'ArrowRight'].includes(event.key)));
      }
    });
    dialog.addEventListener('click', event => {
      if (!dialog.open || closing) return;
      const target = event.target;
      if (!(target instanceof Element) || target.closest('button, a, input, textarea, select, [contenteditable]')) return;
      // Keep dragging to select terminal output available for copying.
      if (window.getSelection()?.isCollapsed === false) return;
      if (editing) {
        if (!nanoConfirm.hidden) return;
        nanoInput.focus({ preventScroll: true });
      } else {
        editor.focus({ preventScroll: true });
        refreshSuggestions(false);
      }
    });
    activate.hidden = false;
    activate.addEventListener('click', () => {
      if (dialog.open) return;
      // Leave a non-interactive copy of the computer in the background.
      placeholder = computer.cloneNode(true) as HTMLElement;
      placeholder.removeAttribute('data-computer');
      placeholder.querySelectorAll('[id]').forEach(element => element.removeAttribute('id'));
      placeholder.inert = true;
      placeholder.setAttribute('aria-hidden', 'true');
      parent.insertBefore(placeholder, computer);
      // Move the same computer into the top layer, retaining the visible CLI.
      dialog.append(computer);
      computer.dataset.active = 'true';
      idlePrompt.hidden = true;
      icon.hidden = true;
      activate.hidden = true;
      close.hidden = false;
      entry.hidden = false;
      transcript.hidden = false;
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      resizeInput();
      const compactText = frame(placeholder.querySelector<HTMLElement>('.terminal strong')!);
      void transition(
        compactComputerFrame(),
        {width: `${computer.offsetWidth}px`, height: `${computer.offsetHeight}px`, transform: 'translate(0px, 0px) rotate(0deg)'},
        compactFrames(), shapes.map(frame),
        {fontSize: compactText.fontSize, lineHeight: compactText.lineHeight},
        {fontSize: getComputedStyle(text).fontSize, lineHeight: getComputedStyle(text).lineHeight},
        true, 'transparent',
      );
      (editing ? nanoInput : editor).focus({ preventScroll: true });
    });
    async function dismiss() {
      if (closing || !dialog!.open) return;
      closing = true;
      const current = {...frame(computer), transform: getComputedStyle(computer).transform};
      const currentShapes = shapes.map(frame);
      const currentText = {fontSize: getComputedStyle(text).fontSize, lineHeight: getComputedStyle(text).lineHeight};
      const background = getComputedStyle(dialog!).backgroundColor;
      stopAnimations();
      const compactText = frame(placeholder!.querySelector<HTMLElement>('.terminal strong')!);
      await transition(
        current,
        compactComputerFrame(),
        currentShapes, compactFrames(), currentText,
        {fontSize: compactText.fontSize, lineHeight: compactText.lineHeight},
        false, background,
      );
      dialog!.close();
    }
    close.addEventListener('click', () => { void dismiss(); });
    dialog.addEventListener('cancel', event => {
      event.preventDefault();
      void dismiss();
    });
    dialog.addEventListener('close', () => {
      stopAnimations();
      parent.insertBefore(computer, nextSibling);
      placeholder?.remove();
      placeholder = null;
      closing = false;
      delete computer.dataset.active;
      idlePrompt.hidden = false;
      icon.hidden = false;
      activate.hidden = false;
      close.hidden = true;
      entry.hidden = true;
      transcript.hidden = true;
      document.documentElement.style.overflow = previousOverflow;
      activate.focus({ preventScroll: true });
    });
    window.addEventListener('resize', () => { if (dialog.open) resizeInput(); });
  });
</script>
